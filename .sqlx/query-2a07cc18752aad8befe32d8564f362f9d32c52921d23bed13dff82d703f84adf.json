  "query": "\n        SELECT \n            id, \n            file_name as \"file_name!\", \n            file_type as \"file_type!\", \n            file_data as \"file_data!\", \n            CONCAT('/api/media/', id::text) as \"file_url!\",\n            created_at as \"created_at!\"\n        FROM media \n        WHERE id = $1\n        ",
